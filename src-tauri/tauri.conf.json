{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cream Corners",
  "version": "0.1.0",
  "identifier": "com.creamcorners.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cream Corners",
        "width": 1000,
        "height": 740,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "decorations": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Cream Corners",
    "category": "Utility",
    "shortDescription": "Hot corners for Windows 10/11",
    "longDescription": "Cream Corners watches the mouse and runs a configurable action when the pointer rests in a screen corner or edge, with per-zone dwell times, drag suppression, fullscreen pause and cooldown."
  }
}
